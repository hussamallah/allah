{
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:force": "node scripts/start-dev.js",
    "dev:force:ps": "powershell -ExecutionPolicy Bypass -File scripts/start-dev.ps1",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "deploy": "vercel --prod",
    "deploy:watch": "vercel --prod --watch",
    "deploy:dev": "vercel",
    "check-env": "node scripts/check-env.js",
    "quiz:sim": "tsx ./scripts/runSim.ts",
    "quiz:test": "vitest run",
    "quiz:test:watch": "vitest",
    "quiz:test:coverage": "vitest run --coverage",
    "quiz:test:coverage:threshold": "vitest run --coverage --coverage.threshold.lines=90 --coverage.threshold.functions=90 --coverage.threshold.branches=90",
    "quiz:sim:multi": "tsx ./scripts/runSim.ts --seeds 1..50",
    "quiz:sim:stress": "tsx ./scripts/runSim.ts --seeds 1..100 --failOnMismatch",
    "quiz:sim:property": "tsx ./scripts/propertyTests.ts",
    "quiz:prop": "tsx scripts/propertyTests.ts",
    "quiz:prop:1k": "tsx scripts/propertyTests.ts --iterations 1000",
    "quiz:test:update-goldens": "tsx ./scripts/runSim.ts --update",
    "quiz:test:mutate": "stryker run",
    "quiz:test:audit": "npm audit",
    "quiz:test:audit:fix": "npm audit fix",
    "quiz:test:all": "npm run quiz:test:coverage:threshold && npm run quiz:sim:stress && npm run quiz:sim:property",
    "quiz:test:ci": "npm ci && npm run quiz:test:coverage:threshold && npm run quiz:sim:stress && npm run quiz:sim:property && npm run quiz:test:audit",
    "hardening:check": "npm run quiz:test:all",
    "hardening:full": "npm run quiz:test:ci",
    "ci:sanity": "tsx scripts/ci-sanity-check.ts",
    "burn:in": "powershell -ExecutionPolicy Bypass -File scripts/multi-seed-burn-in.ps1",
    "burn:in:quick": "powershell -ExecutionPolicy Bypass -File scripts/multi-seed-burn-in.ps1 -StartSeed 1 -EndSeed 50"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.2",
    "@supabase/ssr": "^0.1.0",
    "@supabase/supabase-js": "^2.39.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.1",
    "lucide-react": "^0.511.0",
    "next": "^15.3.1",
    "next-themes": "^0.4.6",
    "node-fetch": "^3.3.2",
    "openai": "^5.8.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@stryker-mutator/core": "^8.0.0",
    "@stryker-mutator/typescript-checker": "^8.0.0",
    "@stryker-mutator/vitest-runner": "^8.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/seedrandom": "^3.0.8",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "15.3.1",
    "postcss": "^8",
    "seedrandom": "^3.0.5",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^2.1.8"
  }
}
